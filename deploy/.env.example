# ==============================================================================
# 充电车位智能防占位与预警系统 - 部署环境变量模板 (测试/生产单文件切换)
# 复制本文件为 deploy/.env 并填入现场值。切勿提交包含真实密钥的 .env 到 Git！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 网络绑定与云端安全配置
# ------------------------------------------------------------------------------
# 局域网全网卡访问填 0.0.0.0；仅本机调试填 127.0.0.1
BIND_IP=0.0.0.0

# PostgreSQL 与云端管理账号（务必修改为强随机密码）
DB_PASS=change-me-strong-postgres-password
CLOUD_SECURITY_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me-strong-operator-password

# 局域网测试(HTTP明文)必须设为 false；生产环境部署 HTTPS 反向代理后必须设为 true！
SESSION_COOKIE_SECURE=false

# 云边通信认证密钥（Cloud 与 Edge 必须完全一致）& OTA 固件验签密钥
EDGE_API_KEY=change-me-random-edge-hmac-key-32chars
EDGE_UPGRADE_SECRET=change-me-random-ota-upgrade-secret-32chars

# ------------------------------------------------------------------------------
# 2. 边缘工控机基础参数 (Intel i3 设备)
# ------------------------------------------------------------------------------
EDGE_NODE_ID=edge-i3-01
EDGE_DATA_DIR=/data/edge

# 同机 Docker Compose 联调填 http://cloud-platform:8080；
# 独立运行 docker-compose.edge-i3.yml 对接远程云端时填 http://<云端服务器IP>:8080；留空表示纯离线自治
EDGE_CLOUD_URL=http://cloud-platform:8080

# 本地边缘管理后台访问密钥（8081端口；留空则在局域网内免密访问 /admin）
EDGE_LOCAL_API_KEY=

# ------------------------------------------------------------------------------
# 3. 硬件继电器选型与「测试 -> 生产」一键切换开关
# ------------------------------------------------------------------------------
# [测试阶段（无物理继电器，用 RTSP 摄像头+图片测试识别落库与状态机）]：
#   EDGE_HARDWARE_MODE=mock
#   EDGE_STRICT_HARDWARE=false
#
# [生产上线（连接物理 Modbus TCP 继电器或 RS-485 声光报警器）]：
#   EDGE_HARDWARE_MODE=modbus-tcp  （或 modbus-rtu）
#   EDGE_STRICT_HARDWARE=true
EDGE_HARDWARE_MODE=mock
EDGE_STRICT_HARDWARE=false

# 当 EDGE_HARDWARE_MODE=modbus-tcp 时生效:
EDGE_MODBUS_TCP_ADDR=
# 当 EDGE_HARDWARE_MODE=modbus-rtu 时生效 (/dev/ttyUSB0 等):
EDGE_MODBUS_RTU_PORT=/dev/ttyUSB0
EDGE_MODBUS_SLAVE_ID=1
EDGE_MODBUS_BAUD_RATE=9600

# ------------------------------------------------------------------------------
# 4. RTSP 视频视觉识别边车 (vision-service)
# ------------------------------------------------------------------------------
# external = 由 Python HyperLPR3 vision-service 拉取 RTSP 流并将车牌号/颜色推送给 edge-node
EDGE_VISION_MODE=external
EDGE_AI_ENGINE=python-hyperlpr3
EDGE_STREAM_MODE=REAL

# RTSP 拉流与多帧识别防抖调优 (针对 Intel i3 16GB 推荐参数)
VISION_RTSP_TRANSPORT=tcp
VISION_INFER_FPS=1.0
VISION_SNAPSHOT_SECONDS=5.0
VISION_TARGET_POLL_SECONDS=10
VISION_MIN_CONFIDENCE=0.72
VISION_VOTE_WINDOW=5
VISION_VOTE_MIN_HITS=2
VISION_EMPTY_CLEAR_FRAMES=4

# 可选：离线直连静态 RTSP 列表（默认留空，自动从 Edge -> Cloud 拓扑同步）
# 示例: [{"cameraId":"CAM-01","spaceId":"A-01","streamUrl":"rtsp://user:pass@192.168.1.101:554/h264/ch1/sub/av_stream","enabled":true}]
VISION_CAMERAS_JSON=

# ------------------------------------------------------------------------------
# 5. 国标 GB28181 SIP 参数与存储容量水位
# ------------------------------------------------------------------------------
EDGE_GB28181_SIP_PORT=5060
EDGE_GB28181_SIP_IP=0.0.0.0
EDGE_GB28181_REALM=3402000000
EDGE_GB28181_SERVER_ID=34020000002000000001
EDGE_GB28181_PASSWORD=
EDGE_EVIDENCE_MAX_BYTES=5368709120
EDGE_DISK_CAPACITY_BYTES=107374182400

# 宿主机端口映射 (可根据需要修改以防端口冲突)
CLOUD_PORT=18080
EDGE_PORT=18081
VISION_PORT=18090

# RTSP 真实摄像头注入 (可选，留空则由边缘网关统一管理下发)
VISION_CAMERAS_JSON=[{"cameraId":"CAM-01","spaceId":"A-01","streamUrl":"rtsp://admin:a1234567@192.168.1.17:554/1/1","enabled":true}]

# 边缘节点上报局域网物理IP（留空则自动检测网卡IP）
EDGE_LAN_IP=192.168.1.8
